# Copy to backend/.env. It is loaded from this fixed location regardless of the working directory;
# real environment variables (e.g. from docker-compose) take precedence.
# Relative paths below are resolved from the project root.

# Database Configuration
# PostgreSQL (production / Docker). Credentials match docker-compose.yml and alembic.ini.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/predictive_maintenance
# Optional quick look without PostgreSQL (no automatic fallback):
# DATABASE_URL=sqlite:///./predictive_maintenance.db

# Application Configuration
APP_NAME="AI-Based Predictive Maintenance System"
API_V1_PREFIX=/api
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Synthetic Data Generation
RANDOM_SEED=20261022
GENERATION_MODE=starter
# Set to 'full' for 1-3M readings, 90 days, 100 machines; 'starter' for 10K-50K readings

# Machine Learning and Report Artifacts
MODEL_PATH=backend/app/ml/saved_models/failure_prediction_rf.joblib
METRICS_PATH=data/reports/model_evaluation_report.json
VALIDATION_REPORT_PATH=data/reports/validation_report.json
FEATURE_MATRIX_PATH=data/processed/feature_matrix.csv
GROUND_TRUTH_PATH=data/ground_truth/ground_truth.csv
PREDICTION_HORIZON_HOURS=24
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_HIGH=0.70
